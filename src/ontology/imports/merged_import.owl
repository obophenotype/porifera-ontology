# Class: <http://purl.obolibrary.org/obo/NCBITaxon_Union_0000024> (Unikonta)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://en.wikipedia.org/wiki/Unikont") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/NCBITaxon_Union_0000024> "The unikonts have a triple-gene fusion that is lacking in the bikonts. The three genes that are fused together in the unikonts but not bacteria or bikonts encode enzymes for synthesis of the pyrimidine nucleotides: carbamoyl phosphate synthase, dihydroorotase, aspartate carbamoyltransferase. This must have involved a double fusion, a rare pair of events, supporting the shared ancestry of Opisthokonta and Amoebozoa.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/NCBITaxon_Union_0000024> "unikonts")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/NCBITaxon_Union_0000024> "Unikonta")
EquivalentClasses(<http://purl.obolibrary.org/obo/NCBITaxon_Union_0000024> ObjectUnionOf(<http://purl.obolibrary.org/obo/NCBITaxon_33154> <http://purl.obolibrary.org/obo/NCBITaxon_554915>))
SubClassOf(<http://purl.obolibrary.org/obo/NCBITaxon_Union_0000024> <http://purl.obolibrary.org/obo/NCBITaxon_2759>)

