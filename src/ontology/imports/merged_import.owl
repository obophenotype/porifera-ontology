SymmetricObjectProperty(<http://purl.obolibrary.org/obo/RO_0002131>)

# Object Property: <http://purl.obolibrary.org/obo/RO_0002150> (continuous with)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/RO_0002150> "X continuous_with Y if and only if X and Y share a fiat boundary.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002150> "continuous with"@en)
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/RO_0002150> <http://purl.obolibrary.org/obo/RO_0002323>)
SymmetricObjectProperty(<http://purl.obolibrary.org/obo/RO_0002150>)
